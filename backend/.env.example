# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
# Public base URL is not required by the API itself (used only in docs examples)
API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Database (SQLite by default; switch provider in prisma/schema.prisma for Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth - ALWAYS replace these in production
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Groq / LLM
# Get a key at https://console.groq.com/keys
# The key stays on the server only. Never expose it to the frontend.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Fast + cheap model for structured triage (JSON output)
GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
# Higher quality model for author-facing drafting
GROQ_MODEL_DRAFT=openai/gpt-oss-120b
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
# Set to false to force heuristic/template mode (useful for demos/offline)
AI_ENABLED=true
# Approximate Groq pricing (USD per 1M tokens) used for cost telemetry
AI_INPUT_PRICE_PER_M=0.15
AI_OUTPUT_PRICE_PER_M=0.60
